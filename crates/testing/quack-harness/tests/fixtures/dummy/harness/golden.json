{
  "schema": 1,
  "package": "org.example.dummy",
  "harness": "dummy-harness",
  "bindings": {},
  "steps": [
    { "install": { "origin": "external:616c696365" } },
    { "expect_query": { "module": "package", "query": { "action_owner": { "tag": "dummy.note.add" } }, "expect": { "owner": "dummy-harness" } } },
    { "submit": { "origin": "external:616c696365", "target": "pages", "payload": { "create_page": { "page_id": "p1", "title": "Dummy", "parent": null } } } },
    { "submit": { "origin": "external:616c696365", "target": "pages", "payload": { "add_comment": { "thread_id": "t1", "comment_id": "c1", "target": "p1", "text": "hey @dummy.note-taker please note this" } } } },
    { "expect_job": { "kind_prefix": "agent/dummy.note-taker", "count": 1 } },
    { "expect_run": { "agent": "dummy.note-taker", "exists": true } },
    { "oracle": { "response": { "reply_blocks": [], "actions": [ { "action_id": "a1", "tag": "dummy.note.add", "payload": { "note_id": "n1", "text": "noted" } } ] } } },
    { "deliver": {} },
    { "expect_run": { "agent": "dummy.note-taker", "exists": false } },
    { "expect_query": { "module": "dummy-harness", "query": "notes", "expect": { "notes": [ { "note_id": "n1", "text": "noted" } ] } } },
    { "expect_job": { "job_id": "dummy:dummy.note-taker:c1", "status": "done", "count": 1 } },
    { "submit": { "origin": "external:616c696365", "target": "pages", "payload": { "add_comment": { "thread_id": "t2", "comment_id": "c2", "target": "p1", "text": "@dummy.note-taker do something sneaky" } } } },
    { "expect_job": { "kind_prefix": "agent/dummy.note-taker", "count": 2 } },
    { "oracle": { "response": { "reply_blocks": [], "actions": [ { "action_id": "a1", "tag": "tasks.create", "payload": { "task_id": "sneaky", "title": "not granted" } } ] } } },
    { "deliver": {} },
    { "expect_failure_row": { "source": "runs", "contains": "is not allowed to tasks.create" } },
    { "expect_query": { "module": "tasks", "query": "list", "expect": { "tasks": [] } } },
    { "expect_job": { "job_id": "dummy:dummy.note-taker:c2", "status": "failed", "count": 1 } },
    { "snapshot_roundtrip": {} },
    { "submit": { "origin": "external:616c696365", "target": "package", "payload": { "suspend": { "package": "org.example.dummy" } } } },
    { "submit": { "origin": "external:616c696365", "target": "pages", "payload": { "add_comment": { "thread_id": "t3", "comment_id": "c3", "target": "p1", "text": "@dummy.note-taker are you there?" } } } },
    { "expect_job": { "kind_prefix": "agent/dummy.note-taker", "count": 2 } },
    { "submit": { "origin": "external:616c696365", "target": "package", "payload": { "resume": { "package": "org.example.dummy" } } } },
    { "submit": { "origin": "external:616c696365", "target": "pages", "payload": { "add_comment": { "thread_id": "t4", "comment_id": "c4", "target": "p1", "text": "@dummy.note-taker welcome back" } } } },
    { "expect_job": { "kind_prefix": "agent/dummy.note-taker", "count": 3 } },
    { "submit": { "origin": "external:616c696365", "target": "package", "payload": { "unplug": { "package": "org.example.dummy" } } } },
    { "expect_query": { "module": "package", "query": { "action_owner": { "tag": "dummy.note.add" } }, "expect": { "owner": null } } },
    { "expect_query": { "module": "dummy-harness", "query": "notes", "expect": { "notes": [ { "note_id": "n1", "text": "noted" } ] } } },
    { "expect_query": { "module": "dummy-harness", "query": "status", "expect": { "status": { "package": "org.example.dummy", "phase": "unplugged", "agents": [ "dummy.note-taker" ], "minted": 3 } } } },
    { "snapshot_roundtrip": {} }
  ]
}
