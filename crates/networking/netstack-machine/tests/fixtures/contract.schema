Event = Enum { tag_width: 1, variants: [(0, "Retarget", "Event__Retarget"), (1, "Deliver", "Event__Deliver"), (2, "ViewTick", "Event__ViewTick"), (3, "Nudge", "Event__Nudge"), (4, "InstallInvitePeer", "Event__InstallInvitePeer"), (5, "BootstrapCoordinatedInvitePeer", "Event__BootstrapCoordinatedInvitePeer"), (6, "SendResolverDatagram", "Event__SendResolverDatagram"), (7, "Resolved", "Event__Resolved"), (8, "RendezvousResolved", "Event__RendezvousResolved"), (9, "DatagramReplied", "Event__DatagramReplied"), (10, "WgApplied", "Event__WgApplied"), (11, "Shutdown", "Event__Shutdown")] }
