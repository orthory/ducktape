UpgradeError = Enum { tag_width: 1, variants: [(0, "InvalidKeyLength", "UpgradeError__InvalidKeyLength"), (1, "EmptyValidatorSet", "UpgradeError__EmptyValidatorSet"), (2, "MissingAdmissionRoot", "UpgradeError__MissingAdmissionRoot"), (3, "DuplicateValidator", "UpgradeError__DuplicateValidator"), (4, "UnknownValidator", "UpgradeError__UnknownValidator"), (5, "MissingAdvertisement", "UpgradeError__MissingAdvertisement"), (6, "StaleDuplicateAdvertisement", "UpgradeError__StaleDuplicateAdvertisement"), (7, "Expired", "UpgradeError__Expired"), (8, "InvalidEndpoint", "UpgradeError__InvalidEndpoint"), (9, "PortPolicyMismatch", "UpgradeError__PortPolicyMismatch"), (10, "MeshVersionMismatch", "UpgradeError__MeshVersionMismatch"), (11, "BadSignature", "UpgradeError__BadSignature"), (12, "HashMismatch", "UpgradeError__HashMismatch"), (13, "HandshakeMismatch", "UpgradeError__HandshakeMismatch"), (14, "BadAckView", "UpgradeError__BadAckView"), (15, "Replay", "UpgradeError__Replay"), (16, "InvalidAllowedIp", "UpgradeError__InvalidAllowedIp"), (17, "InvalidWireGuardKey", "UpgradeError__InvalidWireGuardKey")] }
