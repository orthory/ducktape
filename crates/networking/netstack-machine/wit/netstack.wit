package ducktape:netstack@0.1.0;

/// The host surface the netstack guest may touch. Deliberately tiny: the
/// machine is sans-I/O, so every effect leaves as a returned value, and the
/// imports exist only for the two things a pure step cannot return — a
/// signature under the node's identity (the private key never enters the
/// guest) and a log line into the host's tracing ring.
interface host {
  enum level { trace, debug, info, warn, error }

  /// Sign `message` under `namespace` with the node's ed25519 identity;
  /// returns the 64 signature bytes.
  sign: func(namespace: list<u8>, message: list<u8>) -> list<u8>;
  /// The identity's public key, 32 bytes.
  identity: func() -> list<u8>;
  /// Forward one tracing event. `target` is the guest's own target; the
  /// host re-emits the line under `ducktape::reachability` — the same plane
  /// the native machine logs to, so the trace reads identically whichever
  /// backend produced it — and keeps the guest's target as a field.
  log: func(level: level, target: string, message: string);
}

/// The reachability machine as a component: one long-lived instance per
/// plane life, its state in guest memory between steps. Every value that
/// crosses is the contract's borsh wire form (`netstack_machine::wire`);
/// the contract schema hash pins both sides.
world netstack {
  import host;

  /// Build the machine from a wire `MachineConfig`. Called once before the
  /// first step; a later call replaces the machine with a fresh one.
  export configure: func(config: list<u8>) -> result<_, string>;
  /// Step one wire `Event` at `now-ms` and return the wire step outcome —
  /// the effects to perform in order, or the protocol error that stops the
  /// plane. The error string is a boundary failure: an undecodable event,
  /// or a step before `configure`.
  export step: func(event: list<u8>, now-ms: u64) -> result<list<u8>, string>;
  /// The machine's whole state as the wire `Snapshot` (the contract hash,
  /// then the state): what a backend swap carries. Between steps only.
  export snapshot: func() -> result<list<u8>, string>;
  /// Build the machine from a wire `MachineConfig` and continue it from a
  /// wire `Snapshot` any machine of this contract took under the same
  /// identity. Replaces the machine the way `configure` does; a snapshot
  /// from another contract or identity is refused by name.
  export restore: func(config: list<u8>, snapshot: list<u8>) -> result<_, string>;
}
