{
  "protocol": "tauri-agent-fleet/v1",
  "application": {
    "id": "com.ducktape.app",
    "root": "."
  },
  "lifecycle": {
    "prepareInstance": ["bash", "qa/fleet/prepare-instance.sh"],
    "cleanupInstance": ["bun", "qa/fleet/cleanup-instance.ts"]
  },
  "runtimes": {
    "default": "cef",
    "cef": {
      "build": ["bash", "qa/fleet/build-cef.sh"]
    }
  }
}
