<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown by macOS the first time Ducktape asks for the mic (huddle voice).
       Tauri v2 merges this file, adjacent to tauri.conf.json, into the bundled
       app's Info.plist during the macOS build. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Ducktape uses your microphone for huddle voice chat.</string>
  <!-- Required before getUserMedia({video}) can run under macOS TCC — WITHOUT
       this key the OS terminates the app the moment the camera is touched.
       Gated behind the runtime codec probe, so it only matters once a Mac user
       actually turns their camera on in a huddle. -->
  <key>NSCameraUsageDescription</key>
  <string>Ducktape uses your camera for huddle video chat.</string>
</dict>
</plist>
