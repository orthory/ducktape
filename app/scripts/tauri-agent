#!/usr/bin/env bash
# Thin shim over the released tauri-agent CLI. NOT a protocol driver — it execs
# the package binary and defaults --app to our Tauri identifier when the caller
# didn't already pick a target (--app / --from-html / --port / --host).
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
has_target=0
for a in "$@"; do
  case "$a" in
    --app|--app=*|--from-html|--from-html=*|--port|--port=*|--host|--host=*) has_target=1 ;;
  esac
done
if [ "$has_target" -eq 0 ]; then set -- "$@" --app com.ducktape.app; fi
cd "$repo_root/app"
exec bunx --bun --no-install tauri-agent "$@"
