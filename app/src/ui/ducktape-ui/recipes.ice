recipe page for col
  @w-full h-full p-6 gap-4 bg-bg

recipe content for col
  @w-full gap-4

recipe section for col
  @w-full gap-3

recipe field for col
  @w-full gap-2

recipe cluster for row
  @w-full gap-2 items-center

recipe toolbar for row
  @w-full gap-3 items-center

recipe panel for box
  @w-full p-5 bg-surface border border-border rounded-11px overflow-hidden

recipe surface for box
  @w-full p-3 bg-surface border border-border rounded-11px

recipe inset for box
  @w-full p-3 bg-muted_bg rounded-11px

recipe display for text
  @text-22px leading-tight font-semibold text-primary

recipe screen_title for text
  @text-20px leading-tight font-semibold text-primary

recipe section_title for text
  @text-16px leading-snug font-semibold text-primary

recipe pane_header for text
  @text-14px leading-snug font-semibold text-fg

recipe body for text
  @text-13.5px leading-normal text-accent_fg

recipe list for text
  @text-13px leading-snug font-medium text-accent_fg

recipe caption for text
  @text-12.5px leading-normal text-muted

recipe machine for text
  @text-12px leading-normal font-mono text-secondary_fg

recipe meta for text
  @text-11px leading-normal font-mono font-medium text-muted

recipe meta_compact for text
  @text-10.5px leading-normal font-mono font-medium text-muted

recipe field_label for text
  @text-10px leading-snug font-mono font-semibold text-muted

recipe nav_label for text
  @text-9.5px leading-snug font-semibold text-accent_fg

recipe badge_label for text
  @text-9px leading-snug font-mono font-semibold text-fg

recipe control for input
  @w-full px-13px py-11px bg-surface border border-border rounded-10px focus:border-ring

recipe primary_action for button
  @px-16px py-11px bg-primary text-primary_fg rounded-9px hover:bg-primary/90 pressed:bg-primary/80 disabled:opacity-50

recipe secondary_action for button
  @px-16px py-10px bg-secondary text-secondary_fg border border-control_line rounded-9px hover:bg-accent pressed:bg-muted_bg disabled:opacity-50

recipe outline_action for button
  @px-12px py-7px bg-surface text-accent_fg border border-border rounded-8px hover:bg-muted_bg pressed:bg-accent disabled:opacity-50

recipe ghost_action for button
  @px-12px py-7px bg-transparent text-fg rounded-8px hover:bg-accent pressed:bg-border disabled:opacity-50

recipe danger_action for button
  @px-16px py-11px bg-danger text-danger_fg rounded-9px hover:bg-danger/90 pressed:bg-danger/80 disabled:opacity-50
