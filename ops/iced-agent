#!/usr/bin/env bash
# Thin shim over the iced-agent CLI from byeongsu-hong/iced-agent-browser.
# Cargo consumes the same repo as a git dependency (see [patch.crates-io]);
# this shim keeps the TS CLI available without a submodule by caching a clone.
# Update: rm -rf ~/.cache/iced-agent-browser (or set ICED_AGENT_BROWSER_DIR).
set -euo pipefail
CACHE="${ICED_AGENT_BROWSER_DIR:-$HOME/.cache/iced-agent-browser}"
if [ ! -d "$CACHE/.git" ]; then
  git clone -q https://github.com/byeongsu-hong/iced-agent-browser "$CACHE"
fi
exec bun "$CACHE/plugin/bin/iced-agent.ts" "$@"
