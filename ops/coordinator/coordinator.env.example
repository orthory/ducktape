# Copy to /etc/ducktape/coordinator.env and edit the one line below.
# This is NOT a secret — the coordinator holds no keys. It is only the bind addr.
#
# The wildcard bind is fully functional on a single-IP host (STUN + rendezvous
# + hole-punch all derive from the datagram's observed source). On a MULTI-HOMED
# host, bind the concrete public IP peers dial: replies from a wildcard socket
# egress with the route-chosen source IP, and clients discard replies that do
# not come from the address they dialed.
COORDINATOR_LISTEN=0.0.0.0:3478
# COORDINATOR_LISTEN=203.0.113.10:3478   # multi-homed: bind the dialed IP

# Runtime and optional auth arguments. The supplied value enables four auth
# workers under the default public proof-of-possession policy. For private mode,
# point at the PUBLIC network descriptor; this is still not a secret. Use
# --allow-anonymous only for local/dev smoke.
COORDINATOR_ARGS=--workers 4
# COORDINATOR_ARGS=--workers 4 --genesis-set /etc/ducktape/network.toml
# COORDINATOR_ARGS=--workers 4 --allow-anonymous
